# AgentAllowance verifier — biến môi trường (Render secrets khi deploy).
# KHÔNG điền giá trị thật vào file này. Copy thành .env khi chạy local (không commit .env).
# Verifier chỉ ký, không gửi giao dịch nên ví verifier giữ số dư 0.

# Khóa ký EIP-712 của verifier (bắt buộc để POST /score/attest chạy).
VERIFIER_PRIVATE_KEY=

# RPC BSC mainnet, cần đọc được eth_getLogs (Ankr Freemium / NodeReal MegaNode free).
# Public BSC RPC có thể từ chối eth_getLogs -> /scan fallback sẽ lỗi.
RPC_URL=

# Địa chỉ contract AgentAllowance sau deploy mainnet (TBD cho tới khi deploy thật).
AGENT_ALLOWANCE_ADDRESS=

# Contract Agent ID (mặc định đã đúng mainnet, chỉ đổi khi test).
AGENT_ID_ADDRESS=0x60b9262456de011f7d15a54cdd8c48baaa8b022f

# Etherscan V2 API key (đã có, lưu trong connector custom.etherscan — KHÔNG điền vào file này).
# V2 free chỉ phủ module contract (getsourcecode) trên BSC, KHÔNG phủ logs/block,
# nên /scan vẫn cần RPC đọc được eth_getLogs (xem RPC_URL). Chưa có key: spender ghi "unknown", KHÔNG trừ điểm cờ chưa-verify.
BSCSCAN_API_KEY=

# Port server (Render tự set PORT, local mặc định 3000).
PORT=3000
